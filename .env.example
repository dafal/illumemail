# Illumemail Configuration
# Copy this file to .env and adjust the values as needed

# Server Configuration
# Port on which the application runs
PORT=5000

# Maximum file size for uploaded .eml files (in MB)
MAX_FILE_SIZE_MB=20

# Maximum screenshot height (in pixels)
# Prevents memory issues and timeouts with very long emails
# If an email renders taller than this, the screenshot will be clipped
MAX_SCREENSHOT_HEIGHT=15000

# Offline Mode
# When set to 1, blocks all outgoing network requests during rendering
# (remote images, fonts, tracking pixels, etc. will not be loaded)
# 0 = off (default), 1 = on
OFFLINE_MODE=0

# Attachment Banner
# When set to 1, renders an Outlook-style list of the email's attachments
# (icon, filename, size, MIME type) above the message body
# 0 = off (default), 1 = on
# Can be overridden per request with ?attachment_banner=1 or ?attachment_banner=0
ATTACHMENT_BANNER=0

# Chromium Executable Path
# Path to the Chromium/Chrome binary Puppeteer should launch.
# The Docker image sets this to /usr/bin/chromium (Debian's system Chromium,
# which runs on both amd64 and arm64). Leave unset for local development to use
# Puppeteer's own managed Chromium download.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Logging Configuration
# Log level: error, warn, info, debug
# - error: Only critical errors
# - warn: Warnings and errors
# - info: General information (recommended for production)
# - debug: Detailed debugging information (for development/troubleshooting)
LOG_LEVEL=info

# Log format: json, pretty, simple
# - json: Structured JSON format (recommended for production/log aggregation)
# - pretty: Colorized output with metadata (best for development)
# - simple: Minimal console output (easiest to read)
LOG_FORMAT=json
